<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text.SectionTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/cnsc_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.ScreenTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/cnsc_text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Subtitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/cnsc_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Helper" parent="android:Widget.TextView">
        <item name="android:textColor">@color/cnsc_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.CNSC.Card" parent="">
        <item name="cardBackgroundColor">@color/cnsc_surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/cnsc_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.CNSC.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cnsc_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/button_corner</item>
    </style>

    <style name="Widget.CNSC.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/cnsc_stroke</item>
        <item name="android:textColor">@color/cnsc_text_primary</item>
        <item name="cornerRadius">@dimen/button_corner</item>
    </style>

</resources>
